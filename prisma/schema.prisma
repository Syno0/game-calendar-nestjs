generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Provider {
  TWITCH
  DISCORD
}

model User {
  id             String             @id @default(cuid())
  // Null when the provider gave us no verified email — such an account can
  // never be auto-linked to another provider (see UserAuthService.upsertUser).
  email          String?            @unique
  displayName    String
  avatarUrl      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  // Jeton de partage public. Null = aucun lien actif : le partage est un
  // geste explicite, jamais l'état par défaut. Le régénérer écrase la valeur,
  // ce qui invalide l'ancien lien — c'est le mécanisme de révocation.
  shareToken     String?            @unique
  shareCreatedAt DateTime?
  accounts       Account[]
  favorites      Favorite[]
  shareImages    ShareImageRender[]
}

model Account {
  id                String   @id @default(cuid())
  provider          Provider
  providerAccountId String
  email             String?
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Favorite {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  igdbGameId   Int
  // Snapshot kept only as a display fallback when IGDB is unreachable.
  gameName     String
  coverUrl     String?
  platformSlug String?
  createdAt    DateTime @default(now())

  @@unique([userId, igdbGameId])
  @@index([userId])
}

/// Une image de partage demandée.
///
/// C'est la seule table d'événements du schéma : tout le reste décrit un état
/// (un compte, un favori, un lien), et un état ne dit pas combien de fois on
/// s'en est servi. Une ligne par demande, jamais mise à jour.
model ShareImageRender {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// L'année écrite sur l'image.
  year         Int
  /// "og" (l'aperçu que recadrent les réseaux) ou "full" (l'image entière).
  layout       String
  /// Vrai quand l'image venait du cache : le rendu réel est plus rare que la
  /// demande, et confondre les deux surestimerait le travail fait.
  cached       Boolean  @default(false)
  /// Vrai quand la demande passe par un lien public : ce n'est alors pas le
  /// propriétaire qui regarde, mais quelqu'un à qui il a envoyé le lien.
  viaShareLink Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ─── RAWG, seconde source à côté d'IGDB ──────────────────────────────────────
//
// En base et non dans le cache du NestJS : celui-ci vit en mémoire et se vide
// à chaque redémarrage, alors que RAWG se paie en quota mensuel. Ce qu'on a
// fait venir une fois doit survivre à un déploiement.

/// Un jeu tel que RAWG le décrit, au dernier passage de la synchro.
model RawgGame {
  rawgId         Int        @id
  slug           String
  name           String
  /// Le nom normalisé (`nameKey()`), seule clé commune avec IGDB : celui-ci
  /// ne connaît pas RAWG parmi ses sources externes.
  nameKey        String
  released       DateTime?  @db.Date
  tba            Boolean    @default(false)
  /// Le moment où *notre* synchro a vu la valeur actuelle de `released` pour
  /// la première fois. Null tant qu'on ne l'a jamais vue changer : on ignore
  /// alors depuis quand RAWG la tient, et IGDB garde la main. Le `updated` de
  /// RAWG ne peut pas servir : il bouge pour n'importe quel champ du jeu.
  releasedSeenAt DateTime?
  rawgUpdatedAt  DateTime?
  metacritic     Int?
  rating         Float?
  ratingsCount   Int?
  added          Int?
  addedByStatus  Json?
  esrb           String?
  playtime       Int?
  platformSlugs  String[]
  fetchedAt      DateTime   @default(now())
  links          GameLink[]

  @@index([nameKey])
  @@index([released])
}

/// La correspondance d'un jeu IGDB avec RAWG, trouvée ou non.
model GameLink {
  igdbGameId      Int       @id
  /// Null : cherché sans succès. La ligne existe quand même, pour ne pas
  /// dépenser une recherche RAWG à chaque affichage du même jeu.
  rawgId          Int?
  rawg            RawgGame? @relation(fields: [rawgId], references: [rawgId], onDelete: SetNull)
  /// "name" (nom ou slug retrouvé en base), "search" (recherche RAWG),
  /// "pending" (recherche impossible pour l'instant : quota, panne, clé
  /// absente) ou "manual" (posé depuis /admin, jamais réécrit par la synchro).
  method          String
  score           Float     @default(0)
  checkedAt       DateTime  @default(now())
  /// Le dernier état IGDB connu, recopié à l'affichage : /admin liste les
  /// désaccords et le calendrier retrouve les jeux déplacés sans rappeler IGDB.
  igdbName        String?
  igdbHypes       Int       @default(0)
  igdbDate        DateTime?
  igdbPrecision   String?
  igdbUpdatedAt   DateTime?
  /// Faux quand la ligne IGDB affichée est un portage ou une réédition : RAWG
  /// ne connaît que la sortie d'origine, sa date ne dit rien de celle-ci.
  /// Le lien sert alors aux notes et à la popularité, jamais à la date.
  rawgDateApplies Boolean   @default(true)

  @@index([rawgId])
}

/// La date d'un jeu, imposée depuis /admin. Prime sur tout le reste.
model GameDateOverride {
  igdbGameId Int       @id
  /// "igdb", "rawg" ou "manual" (alors `date` et `precision` sont remplis).
  source     String
  date       DateTime? @db.Date
  precision  String?
  note       String?
  updatedAt  DateTime  @updatedAt
}

/// La dernière synchro d'une liste RAWG (`month:2026-10`).
model RawgSyncState {
  key      String   @id
  syncedAt DateTime
  pages    Int      @default(0)
}

/// Les appels RAWG du jour : le quota gratuit est de 20 000 par mois.
model RawgApiUsage {
  day   DateTime @id @db.Date
  calls Int      @default(0)
}
